#define GROUP_SIZE 1024

#pragma kernel CalcDepthSpark
// Per-splat SH→RGB precompute folded into the depth pass (PlayCanvas "work buffer" parity):
// evaluate view-dependent SH ONCE per splat here (gated with the sort → 0 on a static camera),
// write the RGB to _SplatColorBuffer, and let the draw VERTEX just READ it — instead of
// re-evaluating SH 4x/splat (per quad corner) every frame. Bit-identical: _MatrixMV here equals
// the draw's modelView, so `dir` matches exactly. InitSH/EvalSH are copied verbatim from
// GsplatSpark.hlsl/Gsplat.hlsl (can't #include them — they pull in UNITY_MATRIX_P draw globals).
#pragma multi_compile SH_BANDS_0 SH_BANDS_1 SH_BANDS_2 SH_BANDS_3 SH_BANDS_4

uint _SplatCount;
float4x4 _MatrixMV;
int _RadialDepth;                 // 0 = view-space Z (directional), 1 = radial distance
int _MaskTail;                    // indirect path: 1 = mask order slots >= _DrawCountBuffer[0]
int _SHDegree;                    // effective SH degree = min(asset SHBands, renderer SHDegree)
StructuredBuffer<uint4> _PackedSplatsBuffer;
StructuredBuffer<uint> _OrderBuffer;
StructuredBuffer<uint> _DrawCountBuffer;  // [0] = true appended count (GPU, via CopyCount)
RWStructuredBuffer<float> _DepthBuffer;
#ifndef SH_BANDS_0
RWStructuredBuffer<float4> _SplatColorBuffer;   // per-splat evaluated SH RGB (xyz); read by the draw vert
#endif

// ── SH: coeff count, packed-buffer decls, unpack (verbatim from GsplatSpark.hlsl) ──
#ifndef SH_BANDS_0
#if defined(SH_BANDS_1)
#define SH_COEFFS 3
#elif defined(SH_BANDS_2)
#define SH_COEFFS 8
#elif defined(SH_BANDS_3)
#define SH_COEFFS 15
#elif defined(SH_BANDS_4)
#define SH_COEFFS 24
#endif

StructuredBuffer<uint2> _PackedSH1Buffer;
#if defined(SH_BANDS_2) || defined(SH_BANDS_3) || defined(SH_BANDS_4)
StructuredBuffer<uint4> _PackedSH2Buffer;
#endif
#if defined(SH_BANDS_3) || defined(SH_BANDS_4)
StructuredBuffer<uint4> _PackedSH3Buffer;
#endif
#ifdef SH_BANDS_4
StructuredBuffer<uint4> _PackedSH4Buffer;
#endif

void InitSH(uint id, out float3 sh[SH_COEFFS])
{
    uint2 packedSH1 = _PackedSH1Buffer[id];
    #if defined(SH_BANDS_2) || defined(SH_BANDS_3) || defined(SH_BANDS_4)
    uint4 packedSH2 = _PackedSH2Buffer[id];
    #endif
    #if defined(SH_BANDS_3) || defined(SH_BANDS_4)
    uint4 packedSH3 = _PackedSH3Buffer[id];
    #endif
    #ifdef SH_BANDS_4
    uint4 packedSH4 = _PackedSH4Buffer[id];
    #endif

    sh[0] = float3(int(packedSH1.x << 25u) >> 25, int(packedSH1.x << 18u) >> 25, int(packedSH1.x << 11u) >> 25) / 63.0;
    sh[1] = float3(int(packedSH1.x << 4u) >> 25, int((packedSH1.x >> 3u) | (packedSH1.y << 29u)) >> 25, int(packedSH1.y << 22u) >> 25) / 63.0;
    sh[2] = float3(int(packedSH1.y << 15u) >> 25, int(packedSH1.y << 8u) >> 25, int(packedSH1.y << 1u) >> 25) / 63.0;
    #if defined(SH_BANDS_2) || defined(SH_BANDS_3) || defined(SH_BANDS_4)
    sh[3] = float3(int(packedSH2.x << 24u) >> 24, int(packedSH2.x << 16u) >> 24, int(packedSH2.x << 8u) >> 24) / 127.0;
    sh[4] = float3(int(packedSH2.x) >> 24u, int(packedSH2.y << 24u) >> 24, int(packedSH2.y << 16u) >> 24) / 127.0;
    sh[5] = float3(int(packedSH2.y << 8u) >> 24, int(packedSH2.y) >> 24, int(packedSH2.z << 24u) >> 24) / 127.0;
    sh[6] = float3(int(packedSH2.z << 16u) >> 24, int(packedSH2.z << 8u) >> 24, int(packedSH2.z) >> 24) / 127.0;
    sh[7] = float3(int(packedSH2.w << 24u) >> 24, int(packedSH2.w << 16u) >> 24, int(packedSH2.w << 8u) >> 24) / 127.0;
    #endif
    #if defined(SH_BANDS_3) || defined(SH_BANDS_4)
    sh[8] = float3(int(packedSH3.x << 26u) >> 26, int(packedSH3.x << 20u) >> 26, int(packedSH3.x << 14u) >> 26) / 31.0;
    sh[9] = float3(int(packedSH3.x << 8u) >> 26, int(packedSH3.x << 2u) >> 26, int((packedSH3.x >> 4u) | (packedSH3.y << 28)) >> 26) / 31.0;
    sh[10] = float3(int(packedSH3.y << 22u) >> 26, int(packedSH3.y << 16u) >> 26, int(packedSH3.y << 10u) >> 26) / 31.0;
    sh[11] = float3(int(packedSH3.y << 4u) >> 26, int((packedSH3.y >> 2u) | (packedSH3.z << 30u)) >> 26, int(packedSH3.z << 24u) >> 26) / 31.0;
    sh[12] = float3(int(packedSH3.z << 18u) >> 26, int(packedSH3.z << 12u) >> 26, int(packedSH3.z << 6u) >> 26) / 31.0;
    sh[13] = float3(int(packedSH3.z) >> 26, int(packedSH3.w << 26u) >> 26, int(packedSH3.w << 20u) >> 26) / 31.0;
    sh[14] = float3(int(packedSH3.w << 14u) >> 26, int(packedSH3.w << 8u) >> 26, int(packedSH3.w << 2u) >> 26) / 31.0;
    #endif
    #ifdef SH_BANDS_4
    sh[15] = float3(int(packedSH4.x << 28u) >> 28, int(packedSH4.x << 24u) >> 28, int(packedSH4.x << 20u) >> 28) / 7.0;
    sh[16] = float3(int(packedSH4.x << 16u) >> 28, int(packedSH4.x << 12u) >> 28, int(packedSH4.x << 8u) >> 28) / 7.0;
    sh[17] = float3(int(packedSH4.x << 4u) >> 28, int(packedSH4.x) >> 28, int(packedSH4.y << 28u) >> 28) / 7.0;
    sh[18] = float3(int(packedSH4.y << 24u) >> 28, int(packedSH4.y << 20u) >> 28, int(packedSH4.y << 16u) >> 28) / 7.0;
    sh[19] = float3(int(packedSH4.y << 12u) >> 28, int(packedSH4.y << 8u) >> 28, int(packedSH4.y << 4u) >> 28) / 7.0;
    sh[20] = float3(int(packedSH4.y) >> 28, int(packedSH4.z << 28u) >> 28, int(packedSH4.z << 24u) >> 28) / 7.0;
    sh[21] = float3(int(packedSH4.z << 20u) >> 28, int(packedSH4.z << 16u) >> 28, int(packedSH4.z << 12u) >> 28) / 7.0;
    sh[22] = float3(int(packedSH4.z << 8u) >> 28, int(packedSH4.z << 4u) >> 28, int(packedSH4.z) >> 28) / 7.0;
    sh[23] = float3(int(packedSH4.w << 28u) >> 28, int(packedSH4.w << 24u) >> 28, int(packedSH4.w << 20u) >> 28) / 7.0;
    #endif
}

// ── SH constants + EvalSH (verbatim from Gsplat.hlsl) ──
#define SH_C1 0.4886025119029199f
#define SH_C2_0 1.0925484305920792f
#define SH_C2_1 -1.0925484305920792f
#define SH_C2_2 0.31539156525252005f
#define SH_C2_3 -1.0925484305920792f
#define SH_C2_4 0.5462742152960396f
#define SH_C3_0 -0.5900435899266435f
#define SH_C3_1 2.890611442640554f
#define SH_C3_2 -0.4570457994644658f
#define SH_C3_3 0.3731763325901154f
#define SH_C3_4 -0.4570457994644658f
#define SH_C3_5 1.445305721320277f
#define SH_C3_6 -0.5900435899266435f
#define SH_C4_0 0.6258357354491761f
#define SH_C4_1 -1.7701307697799304f
#define SH_C4_2 0.9461746957575601f
#define SH_C4_3 -0.6690465435572892f
#define SH_C4_4 0.10578554691520431f
#define SH_C4_5 -0.6690465435572892f
#define SH_C4_6 0.47308734787878004f
#define SH_C4_7 -1.7701307697799304f
#define SH_C4_8 0.6258357354491761f

float3 EvalSH(const inout float3 sh[SH_COEFFS], float3 dir, int degree)
{
    if (degree == 0)
        return float3(0, 0, 0);
    float x = dir.x, y = dir.y, z = dir.z;
    float3 result = SH_C1 * (-sh[0] * y + sh[1] * z - sh[2] * x);
    if (degree == 1)
        return result;
    #if defined(SH_BANDS_2) || defined(SH_BANDS_3) || defined(SH_BANDS_4)
    float xx = x * x, yy = y * y, zz = z * z, xy = x * y, yz = y * z, xz = x * z;
    result = result + (
        sh[3] * (SH_C2_0 * xy) + sh[4] * (SH_C2_1 * yz) + sh[5] * (SH_C2_2 * (2.0 * zz - xx - yy)) +
        sh[6] * (SH_C2_3 * xz) + sh[7] * (SH_C2_4 * (xx - yy)));
    if (degree == 2)
        return result;
    #endif
    #if defined(SH_BANDS_3) || defined(SH_BANDS_4)
    result = result + (
        sh[8] * (SH_C3_0 * y * (3.0 * xx - yy)) + sh[9] * (SH_C3_1 * xy * z) +
        sh[10] * (SH_C3_2 * y * (4.0 * zz - xx - yy)) + sh[11] * (SH_C3_3 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy)) +
        sh[12] * (SH_C3_4 * x * (4.0 * zz - xx - yy)) + sh[13] * (SH_C3_5 * z * (xx - yy)) +
        sh[14] * (SH_C3_6 * x * (xx - 3.0 * yy)));
    if (degree == 3)
        return result;
    #endif
    #ifdef SH_BANDS_4
    result = result + (
        sh[15] * (SH_C4_0 * xy * (xx - yy)) + sh[16] * (SH_C4_1 * yz * (3.0 * xx - yy)) +
        sh[17] * (SH_C4_2 * xy * (6.0 * zz - xx - yy)) + sh[18] * (SH_C4_3 * yz * (4.0 * zz - 3.0 * xx - 3.0 * yy)) +
        sh[19] * (SH_C4_4 * (35.0 * zz * zz - 30.0 * zz + 3.0)) + sh[20] * (SH_C4_5 * xz * (4.0 * zz - 3.0 * xx - 3.0 * yy)) +
        sh[21] * (SH_C4_6 * (xx - yy) * (6.0 * zz - xx - yy)) + sh[22] * (SH_C4_7 * xz * (xx - 3.0 * yy)) +
        sh[23] * (SH_C4_8 * (xx * xx - 6.0 * xx * yy + yy * yy)));
    #endif
    return result;
}
#endif // !SH_BANDS_0

[numthreads(GROUP_SIZE,1,1)]
void CalcDepthSpark(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    // Indirect (readback-free) path: the dispatch is sized to the CPU capacity (selectedTotal),
    // which is >= the true appended count. Slots [trueCount, capacity) hold stale ids — give them
    // +inf depth so the radix sorts them to the BACK; the draw then discards order >= trueCount.
    if (_MaskTail != 0 && idx >= _DrawCountBuffer[0])
    {
        _DepthBuffer[idx] = 3.4e38f;
        return;
    }

    uint sid = _OrderBuffer[idx];
    uint4 word = _PackedSplatsBuffer[sid];
    float3 pos = float3(f16tof32(word.y & 0xffffu), f16tof32((word.y >> 16u) & 0xffffu), f16tof32(word.z & 0xffffu));
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;
    // Directional key = view Z (camera looks -Z, so farther = more negative = sorts first,
    // back-to-front). Radial key = -distance to camera; in VIEW space the camera is the
    // origin so |pos| IS that distance. Radial order is rotation-invariant (only translation
    // changes it) — lets the sort be skipped during XR head rotation. Both keys are negative
    // for in-front splats, so the existing float radix (which handles view-Z) sorts both.
    _DepthBuffer[idx] = _RadialDepth != 0 ? -length(pos) : pos.z;

    // Per-splat SH→RGB: model-space view dir = MV^T · viewPos (mul(vec,mat3) = mat^T·vec),
    // bit-identical to the draw vert's `normalize(mul(center.view,(float3x3)modelView))`.
    #ifndef SH_BANDS_0
    float3 dir = normalize(mul(pos, (float3x3)_MatrixMV));
    float3 sh[SH_COEFFS];
    InitSH(sid, sh);
    _SplatColorBuffer[sid] = float4(EvalSH(sh, dir, _SHDegree), 0.0);
    #endif
}