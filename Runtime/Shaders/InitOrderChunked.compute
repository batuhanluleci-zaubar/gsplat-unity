//
// Chunked-LOD visible-set builder. The asset is a single combined PackedSplats
// buffer holding every LOD level (level 0 = finest, then coarser levels), baked by
// tools/bake_chunks.py. Each splat carries a packed (chunkId<<4 | level) tag; a
// per-chunk _SelectedLevel (chosen on the CPU by cull + LOD selection) decides which
// level of each chunk is drawn this frame. A splat is appended to _OrderBuffer iff
// its level equals its chunk's selected level (and it survives the frustum test).
// Culled chunks set _SelectedLevel = 0xFFFFFFFF so none of their splats match.

#define GROUP_SIZE 1024

#pragma kernel InitOrderChunked
#pragma kernel InitOrderPool
#pragma multi_compile __ FRUSTUM_CULL

uint _SplatCount;                          // combined buffer splat count

AppendStructuredBuffer<uint> _OrderBuffer;
StructuredBuffer<uint> _PoolLiveMask;      // InitOrderPool: bit per pool slot, 1 = live splat
StructuredBuffer<uint4> _PackedSplatsBuffer;
StructuredBuffer<uint>  _SplatChunk;       // per-splat: (chunkId << 4) | level (level 0..15)
StructuredBuffer<uint>  _SelectedLevel;    // per-chunk chosen level; 0xFFFFFFFF = chunk culled
StructuredBuffer<uint>  _FadeWeight;       // per-chunk LOD cross-fade weight 0..255 (0 = no fade)

#ifdef FRUSTUM_CULL
float4 _FrustumPlanes[6];                  // object-space, inward normals, normalized
float  _CullMargin;

// Spark packed log-scale range (see GsplatSpark.hlsl UnpackSplat).
#define LN_SCALE_MIN -12.0
#define LN_SCALE_MAX 9.0

// Keep a splat unless its 3σ Gaussian FOOTPRINT is fully outside the frustum — NOT just its
// centre. A centre-only test culls splats whose centre is just past the edge while their
// footprint is still on screen, which strips/empties partly-visible chunks when the margin is
// small (the reported "looking-at-it culls" bug). Using the splat's own extent as the margin
// gives a smooth, content-accurate edge — no whole-chunk pop, no manual margin tuning.
bool FootprintInFrustum(float3 pos, float footprint)
{
    [unroll]
    for (int p = 0; p < 6; ++p)
        if (dot(_FrustumPlanes[p].xyz, pos) + _FrustumPlanes[p].w < -(footprint + _CullMargin))
            return false;
    return true;
}

// Largest 3σ axis of a packed splat (Spark word3 = per-axis 8-bit log-scale).
float SplatFootprint(uint4 ps)
{
    uint3 uScale = uint3(ps.w & 0xFFu, (ps.w >> 8u) & 0xFFu, (ps.w >> 16u) & 0xFFu);
    float lss = (LN_SCALE_MAX - LN_SCALE_MIN) / 254.0;
    float3 sc = float3(
        uScale.x == 0u ? 0.0 : exp(LN_SCALE_MIN + float(uScale.x - 1u) * lss),
        uScale.y == 0u ? 0.0 : exp(LN_SCALE_MIN + float(uScale.y - 1u) * lss),
        uScale.z == 0u ? 0.0 : exp(LN_SCALE_MIN + float(uScale.z - 1u) * lss));
    return 3.0 * max(sc.x, max(sc.y, sc.z));
}
#endif

[numthreads(GROUP_SIZE, 1, 1)]
void InitOrderChunked(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint packed = _SplatChunk[idx];
    uint chunkId = packed >> 4u;
    uint level = packed & 0xFu;

    // Draw the level selected for this chunk. When the chunk is cross-fading (fade weight != 0),
    // ALSO draw its next coarser level (selected+1); the draw shader ramps the two levels' opacity
    // so the LOD swap doesn't pop. Culled chunks have selected 0xFFFFFFFF and fade 0 → match nothing.
    uint sel = _SelectedLevel[chunkId];
    if (level != sel && !(_FadeWeight[chunkId] != 0u && sel != 0xFFFFFFFFu && level == sel + 1u))
        return;

#ifdef FRUSTUM_CULL
    uint4 ps = _PackedSplatsBuffer[idx];
    float3 pos = float3(f16tof32(ps.y & 0xFFFFu), f16tof32((ps.y >> 16u) & 0xFFFFu), f16tof32(ps.z & 0xFFFFu));
    if (!FootprintInFrustum(pos, SplatFootprint(ps)))
        return;
#endif

    _OrderBuffer.Append(idx);
}

// Streaming-pool visible-set builder (incremental refill). The pool buffer holds resident
// chunk blocks at allocator-chosen offsets with HOLES between them (stale data from freed
// blocks). Append only the slots the CPU-side allocator marked live — holes never reach the
// sort/draw. _SplatCount here = the allocator's UsedEnd (highest allocated end).
[numthreads(GROUP_SIZE, 1, 1)]
void InitOrderPool(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    // Live-mask check FIRST: a hole (freed / not-yet-loaded slot, bit 0) returns before the
    // frustum test ever reads _PackedSplatsBuffer[idx], so STALE packed data at a hole is never
    // footprint-tested (garbage could otherwise pass the test and append a bad index).
    if (!(((_PoolLiveMask[idx >> 5u] >> (idx & 31u)) & 1u)))
        return;

#ifdef FRUSTUM_CULL
    // A3: per-splat frustum cull on the resident pool — the SAME 3σ-footprint test the combined
    // InitOrderChunked kernel uses, so the pool draws only the VISIBLE subset (not the whole
    // resident set). Pool slots are copied verbatim from the object-space asset, so this reads the
    // right splat. RemainingCount must then come from a CopyCount readback (fewer appended than live).
    uint4 ps = _PackedSplatsBuffer[idx];
    float3 pos = float3(f16tof32(ps.y & 0xFFFFu), f16tof32((ps.y >> 16u) & 0xFFFFu), f16tof32(ps.z & 0xFFFFu));
    if (!FootprintInFrustum(pos, SplatFootprint(ps)))
        return;
#endif

    _OrderBuffer.Append(idx);
}
